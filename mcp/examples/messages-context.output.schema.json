{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessagesContextOutputExample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "messages",
    "coverage",
    "truncated",
    "nextCursor"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "messages": {
      "type": "array",
      "maxItems": 201,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "sentAt",
          "content",
          "contentTruncated",
          "decodeStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 19
          },
          "sentAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "contentTruncated": {
            "type": "boolean"
          },
          "decodeStatus": {
            "enum": [
              "decoded",
              "unparsed",
              "unsupported"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "asOf",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "scope": {
          "const": "authorized_published_context"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  }
}

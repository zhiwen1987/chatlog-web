# Chatlog Enterprise 环境变量示例（复制为 .env 使用）
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=chatlog
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=chatlog
POSTGRES_PORT=5432

# MinIO（S3 兼容对象存储）
MINIO_ROOT_USER=chatlog
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Server
SERVER_PORT=8080
CHATLOG_JWT_SECRET=change-me-jwt-secret